{
  "description": "github-workflow: accidental closing-keyword gate on PRs and an ask before a git command discards uncommitted changes (every repo); duplicate-search record, label taxonomy and deploy-impact gates, and an ask before an edit, commit or push on the default branch (repos with .github/github-workflow.json).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\"", "timeout": 15 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\"", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\"",
            "timeout": 45,
            "statusMessage": "Checking issue labels..."
          }
        ]
      }
    ]
  }
}
